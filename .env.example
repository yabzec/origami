DATABASE_URL=postgresql+psycopg://origami:origami@localhost:5432/origami
STORAGE_PATH=./storage
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
# --- Chat / text LLM (LiteLLM model strings select the provider) ---
# Only the chat path is remote. Set the model string + one API key. Examples:
#   Gemini:  LLM_MODEL=gemini/gemini-2.5-flash        LLM_API_KEY=<google key>
#   Groq:    LLM_MODEL=groq/llama-3.3-70b-versatile   LLM_API_KEY=<groq key>
#   OpenAI:  LLM_MODEL=openai/gpt-4o-mini             LLM_API_KEY=<openai key>
#   Ollama:  LLM_MODEL=ollama/llama3.1  LLM_API_BASE=http://localhost:11434  (no key)
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
LLM_API_BASE=
# Legacy: still honored by LiteLLM if set instead of LLM_API_KEY.
GEMINI_API_KEY=
# --- Embeddings: Cloudflare Workers AI (BAAI/bge-m3), via LiteLLM's OpenAI path ---
# Free tier is 10,000 Neurons/day (~9.3M input tokens for bge-m3), resets 00:00 UTC.
# Create an API token with the "Workers AI" read permission, and take the account id
# from the Cloudflare dashboard URL. Both indexing and search use this one model —
# never point them at different providers, or the stored and query vectors stop
# being comparable and search silently returns noise.
EMBEDDING_MODEL=openai/@cf/baai/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# Changing EMBEDDING_MODEL to a model with a different vector size requires a matching
# migration for the EMBEDDING_DIM constant in app/models/chunk.py (a code constant, not
# an env var) plus a full re-embed of every chunk.
# --- Vision runs LOCALLY on CPU. No API key needed. ---
# ~3.7GB downloaded from HuggingFace on first use; set HF_HOME to move the cache.
# Loaded per call and released, so it costs nothing at rest.
# VISION_MODEL_NAME=vikhyatk/moondream2
# VISION_MODEL_REVISION=6b714b26eea5cbd9f31e4edb2541c170afa935ba      # pinned; we execute this repo's code
DEFAULT_OCR_LANGUAGES=ita+eng
RAG_TOP_K=8
RAG_RELEVANCE_FLOOR=0.35
